                <span class="h-badge-lbl">Flavors</span>
              </div>
              <div class="h-badge">
                <span class="h-badge-num">100%</span>
                <span class="h-badge-lbl">Natural</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-scroll">
        <div class="scroll-line"></div>
        <span>Scroll</span>
      </div>
    </section>

    <div class="hours-band">
      <div class="hours-band-inner">
        <div class="hb-section">
          <span class="hb-label">Visit Our Store</span>
          <div class="hb-hours">
            <div class="hb-item"><span>Mon–Fri:</span> 10am – 6pm</div>
            <div class="hb-item"><span>Sat:</span> 10am – 4pm</div>
          </div>
        </div>
        <div class="hb-contact">
          <a
