    <section class="tasting-band">
      <div class="tasting-inner">
        <span class="tasting-olive">🌿</span>
        <p class="tasting-text">
          <strong>Pro Tip</strong>
          "Try drizzling our 18-Year Aged Traditional Balsamic over fresh
          Alabama peaches and vanilla bean gelato for a transformative summer
          dessert."
        </p>
      </div>
    </section>

    <section class="shop" id="shop">
      <div class="sec-header">
        <div class="sh-left">
          <span class="sec-eyebrow">Explore the Pantry</span>
          <h2 class="sec-title">Our <em>Featured</em> Selection</h2>
        </div>
        <div class="filter-row">
          <button
            class="ftab active"
            onclick="filterShop('all')"
            aria-label="Show all products"
          >
            All
          </button>
          <button
            class="ftab"
            onclick="filterShop('oil')"
            aria-label="Show only oils"
          >
            Oils
          </button>
          <button
            class="ftab"
            onclick="filterShop('vinegar')"
            aria-label="Show only vinegars"
          >
            Vinegars
          </button>
          <button
            class="ftab"
            onclick="filterShop('spice')"
            aria-label="Show only spices"
          >
            Spices
          </button>
        </div>
      </div>

      <div class="pgrid" id="product-grid"></div>
    </section>

    <section class="refill" id="refill">
      <div class="refill-inner">
        <div class="refill-text">
          <div class="re">Sustainability in Every Drop</div>
          <h2>Join the <em>Refill</em> Revolution</h2>
          <p>
            Bring your empty Nick of Thyme bottles back to the shop and enjoy a
            significant discount on your favorites. It's better for the planet
            and better for your wallet.
          </p>

          <div class="refill-grid">
            <div class="ri">
              <strong>Eco-Friendly</strong>
              <span>Reduce glass waste by 80%</span>
            </div>
            <div class="ri">
              <strong>Always Fresh</strong>
              <span>Bottled straight from the fusti</span>
            </div>
            <div class="ri">
              <strong>Refill Day</strong>
              <span id="next-refill-day">Loading next Thursday...</span>
            </div>
            <div class="ri">
              <strong>Easy Process</strong>
              <span>We clean and sanitize for you</span>
            </div>
          </div>
          <button class="btn-gold" aria-label="Learn how it works">
            How it Works
          </button>
        </div>

        <div
          class="savings-card"
          role="region"
          aria-label="Savings Information"
        >
          <span class="savings-big">35<sup>%</sup></span>
          <span class="savings-lbl">Average Savings per bottle</span>
          <p class="savings-note">
            Join 1,200+ locals who have helped us divert over 5,000 bottles from
            landfills this year alone.
          </p>
        </div>
      </div>
    </section>

    <section class="about" id="about">
      <div class="about-inner">
        <div class="about-img-wrap">
          <div class="about-img">
            <span style="font-size: 4rem; opacity: 0.1">🏠</span>
          </div>
          <div class="about-accent">
            <strong>12+</strong>
            <span>Years in Wetumpka</span>
          </div>
        </div>
        <div class="about-text">
          <span class="sec-eyebrow">Our Story</span>
          <h2>Crafting <em>Flavor</em> for the Local Table</h2>
          <p>
            Founded with a passion for the Mediterranean lifestyle, Nick of
            Thyme began as a small stall and grew into Wetumpka's destination
            for artisan ingredients.
          </p>
          <div class="about-quote">
            <blockquote>
              "Quality isn't just an ingredient; it's a commitment to the
              farmers, the process, and the community that gathers around the
              table."
            </blockquote>
            <cite>— Nick, Founder</cite>
          </div>
          <div class="about-feats">
            <div class="af">
              <div class="af-icon">🌱</div>
              <div class="af-text">
                <strong>Pure Sourcing</strong
                ><span>No fillers or additives</span>
              </div>
            </div>
            <div class="af">
              <div class="af-icon">🏺</div>
              <div class="af-text">
                <strong>Traditional</strong><span>Old-world methods</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="reviews">
      <div
        class="sec-header"
        style="justify-content: center; text-align: center"
      >
        <div>
          <span class="sec-eyebrow">Customer Love</span>
          <h2 class="sec-title">What Our <em>Neighbors</em> Say</h2>
        </div>
      </div>
      <div class="reviews-grid">
        <div class="rcard" role="article">
          <div class="rstars">★★★★★</div>
          <p class="rtext">
            "The Garlic Infused Olive Oil is a game changer for my roasted
            potatoes. I never shop anywhere else for my pantry staples."
          </p>
          <div class="rauthor">Sarah T.</div>
          <div class="rsource">Verified Local</div>
        </div>
        <div class="rcard" role="article">
          <div class="rstars">★★★★★</div>
          <p class="rtext">
