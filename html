              <span>View on Interactive Map</span>
              <p>Get directions to the shop</p>
            </a>
          </div>
        </div>

        <div class="hours-box">
          <h3>Shop Hours</h3>
          <div class="hrow">
            <span class="day">Monday</span
            ><span class="time" id="hour-mon">10:00 AM – 6:00 PM</span>
          </div>
          <div class="hrow">
