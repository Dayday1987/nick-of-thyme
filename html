    <section class="cats">
      <div class="cats-inner">
        <div
          class="cat-card"
          onclick="filterShop('oil')"
          role="button"
          aria-label="View Olive Oils"
        >
          <span class="cat-icon">🫒</span>
          <span class="cat-name">Olive Oils</span>
          <span class="cat-sub">Extra Virgin & Infused</span>
        </div>
        <div
          class="cat-card"
          onclick="filterShop('vinegar')"
          role="button"
          aria-label="View Vinegars"
        >
          <span class="cat-icon">🍇</span>
          <span class="cat-name">Vinegars</span>
          <span class="cat-sub">Balsamic & Specialty</span>
        </div>
        <div
          class="cat-card"
          onclick="filterShop('spice')"
          role="button"
          aria-label="View Spices"
