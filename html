          <div class="hrow">
            <span class="day">Sunday</span
            ><span class="closed" id="hour-sun">Closed</span>
          </div>
          <div class="refill-note">
            <strong>Refill Special:</strong> Every Thursday!
          </div>
        </div>
      </div>
    </section>

