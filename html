    <div
      class="cart-overlay"
      id="cart-overlay"
      onclick="toggleCart(false)"
    ></div>
    <div class="cart-drawer" id="cart-drawer">
      <div class="cart-head">
        <h2>Your Pantry</h2>
        <button
          class="close-cart"
          onclick="toggleCart(false)"
          aria-label="Close cart"
        >
          &times;
        </button>
      </div>
      <div class="cart-body" id="cart-items-container"></div>
      <div class="cart-foot" id="cart-footer"></div>
    </div>

    <button
      class="admin-trigger"
      onclick="openAdmin()"
      title="Admin Settings"
      aria-label="Admin Settings"
    >
      ⚙️
    </button>

    <div class="admin-modal" id="admin-modal">
      <div class="admin-card">
        <div class="admin-header">
          <h2>Store Manager</h2>
          <button
            onclick="closeAdmin()"
            style="
              background: none;
              border: none;
              color: #fff;
              cursor: pointer;
              font-size: 1.5rem;
            "
          >
            &times;
          </button>
        </div>
        <div class="admin-tabs">
          <div class="atab active" onclick="switchAdminTab('ann', this)">
            Announcement
          </div>
          <div class="atab" onclick="switchAdminTab('hours', this)">
            Store Hours
          </div>
          <div class="atab" onclick="switchAdminTab('products', this)">
            Products
          </div>
        </div>
        <div class="admin-content">
          <div id="tab-ann" class="admin-panel active">
            <div class="admin-field">
              <label>Top Bar Announcement</label>
              <textarea id="announceText" class="admin-input" rows="3">
FREE SHIPPING ON ORDERS OVER $75 • <a>JOIN OUR TASTING CLUB</a></textarea
              >
            </div>
            <button class="btn-gold" onclick="saveAnnouncement()">
              Update Banner
            </button>
          </div>

          <div id="tab-hours" class="admin-panel">
            <div
              class="admin-field"
              style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem"
            >
              <div>
                <label>Mon-Fri</label
                ><input
                  type="text"
                  id="hour-mon-in"
                  class="admin-input"
                  value="10:00 AM – 6:00 PM"
                />
              </div>
              <div>
                <label>Saturday</label
                ><input
                  type="text"
                  id="hour-sat-in"
                  class="admin-input"
                  value="10:00 AM – 4:00 PM"
