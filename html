                  y="20"
                  width="100"
                  height="380"
                  rx="40"
                  fill="#2c1e0f"
                  stroke="#c8972a"
                  stroke-width="2"
                />
                <rect
                  x="100"
                  y="0"
                  width="40"
                  height="40"
                  rx="4"
                  fill="#c8972a"
                />
                <rect
                  x="80"
                  y="140"
                  width="80"
                  height="100"
                  rx="2"
                  fill="#ede6d5"
                  opacity="0.9"
                />
                <text
                  x="120"
                  y="195"
                  text-anchor="middle"
                  font-family="Playfair Display"
                  font-size="12"
                  fill="#2c1e0f"
                  font-weight="bold"
                >
                  ARTISAN OIL
                </text>
              </svg>
            </div>
            <div class="hero-badges">
              <div class="h-badge">
