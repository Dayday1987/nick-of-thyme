              </div>
            </div>
            <button class="btn-gold" onclick="saveHours()">Save Hours</button>
          </div>

          <div id="tab-products" class="admin-panel">
            <p style="font-size: 0.8rem; color: var(--text-mid)">
              Product management coming soon to this dashboard.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="toast" id="toast">Item added to cart!</div>
